# ============================================================
# La Marmite du Kloto — Variables d'environnement Backend
# ============================================================

# ---- Django ----
SECRET_KEY=dev-insecure-a-remplacer-en-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- MongoDB ----
# Base locale (mongod installé sur ce PC)
MONGO_URL=mongodb://localhost:27017
# Cluster Atlas (synchronisation) — RÉGÉNÉREZ CE MOT DE PASSE dans Atlas.
MONGO_URL_ATLAS=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority
DB_NAME=marmite_kloto_db

# ---- CORS (frontend React en dev) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000

# ---- Synchronisation ----
SYNC_INTERVAL_SECONDS=15
